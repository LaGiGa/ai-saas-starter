# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for direct OpenAI API streaming.
# If not provided, the starter includes automated fallback to Gemini with the same OpenAI streaming protocol.
OPENAI_API_KEY="sk-..."

# NEXT_PUBLIC_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Your Supabase Anonymous Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# SUPABASE_SERVICE_ROLE_KEY: Optional elevated server-side key for quota operations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
